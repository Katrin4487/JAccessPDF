<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>



    <groupId>de.fkkaiser</groupId>
    <artifactId>jaccess-pdf</artifactId>
    <version>0.11.1</version>
    <packaging>pom</packaging>

    <name>JAccessPDF</name>
    <description>A Java library for creating PDF/UA compliant PDFs with Apache FOP</description>
    <url>https://github.com/Katrin4487/JAccessPDF</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>katrin4487</id>
            <name>Katrin Kaiser</name>
            <url>https://github.com/Katrin4487</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Katrin4487/JAccessPDF.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Katrin4487/JAccessPDF.git</developerConnection>
        <url>https://github.com/Katrin4487/JAccessPDF/tree/master</url>
    </scm>

    <modules>
        <module>api</module>
        <module>generator</module>
        <module>model</module>
        <module>processor</module>
        <module>postprocessor</module>
        <module>bundle</module>
        <module>markdown</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.release>21</java.release>

        <slf4j.version>2.0.13</slf4j.version>
        <jackson.version>2.17.2</jackson.version>
        <fop.version>2.11</fop.version>
        <commonmark.version>0.31.0</commonmark.version>
        <junit-jupiter.version>5.10.3</junit-jupiter.version>

        <maven.compiler.version>3.13.0</maven.compiler.version>
        <maven.surefire.version>3.3.1</maven.surefire.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Katrin4487/JAccessPDF</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Katrin4487/JAccessPDF</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Only the markdown module needs this; kept out of the root <dependencies>
                 (unlike slf4j/fop/Saxon) so it is not pulled into every module's classpath. -->
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>fop</artifactId>
            <version>${fop.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.saxon</groupId>
            <artifactId>Saxon-HE</artifactId>
            <version>12.5</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <!-- Run tests on the classpath, not the module path: JUnit needs
                         reflective access to test classes that production module-info.java
                         intentionally doesn't grant (it only opens packages to Jackson). -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <source>${java.release}</source>
                    <detectOfflineLinks>false</detectOfflineLinks>
                    <failOnError>false</failOnError>
                    <links>
                        <link>https://javadoc.io/doc/org.apache.xmlgraphics/fop-core/latest/</link>
                    </links>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.5</version>
                <configuration>
                    <header>${maven.multiModuleProjectDirectory}/license-header.txt</header>
                    <properties>
                        <owner>Katrin Kaiser</owner>
                        <year>2025</year>
                    </properties>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                    </mapping>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>**/.idea/**</exclude>
                    </excludes>
                    <strictCheck>true</strictCheck>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- NOTE: unrelated to the com.mycila plugin above despite the identical
                 artifactId - that one checks source file license HEADERS, this one
                 aggregates the LICENSES OF THIRD-PARTY DEPENDENCIES into THIRD-PARTY.txt.
                 Intentionally has no bound <executions>/<phase>: running it needs network
                 access to resolve license metadata, so it must stay a deliberate, manual
                 step (`mvn org.codehaus.mojo:license-maven-plugin:2.7.1:aggregate-add-third-party`),
                 not something that fires on every build. Always invoke it by its full
                 groupId:artifactId:version coordinates - both plugins share the short
                 "license" prefix, and declaring both here makes that prefix ambiguous. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <configuration>
                    <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <excludedScopes>test</excludedScopes>
                    <failOnMissing>false</failOnMissing>
                </configuration>
            </plugin>
        </plugins>

    </build>

</project>