<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>



    <groupId>de.fkkaiser</groupId>
    <artifactId>jaccess-pdf</artifactId>
    <version>0.11.3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JAccessPDF</name>
    <description>A Java library for creating PDF/UA compliant PDFs with Apache FOP</description>
    <url>https://github.com/Katrin4487/JAccessPDF</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>katrin4487</id>
            <name>Katrin Kaiser</name>
            <url>https://github.com/Katrin4487</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Katrin4487/JAccessPDF.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Katrin4487/JAccessPDF.git</developerConnection>
        <url>https://github.com/Katrin4487/JAccessPDF/tree/master</url>
    </scm>

    <modules>
        <module>api</module>
        <module>generator</module>
        <module>model</module>
        <module>processor</module>
        <module>postprocessor</module>
        <module>bundle</module>
        <module>markdown</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.release>25</java.release>

        <slf4j.version>2.0.20</slf4j.version>
        <jackson.version>2.22.4</jackson.version>
        <fop.version>2.12</fop.version>
        <commonmark.version>0.31.0</commonmark.version>
        <junit-jupiter.version>5.10.3</junit-jupiter.version>

        <maven.compiler.version>3.16.0</maven.compiler.version>
        <maven.surefire.version>3.6.0</maven.surefire.version>
        <mockito.version>5.24.0</mockito.version>

        <maven.gpg.version>3.2.8</maven.gpg.version>
        <central.publishing.version>0.12.0</central.publishing.version>
        <!-- Long key ID of the GPG signing key used for Maven Central releases.
             Public key must be on keyserver.ubuntu.com / keys.openpgp.org, or
             Central rejects the upload. The passphrase is deliberately NOT stored
             anywhere in this repo or in settings.xml: locally gpg-agent prompts
             for it, in CI it is passed as -Dgpg.passphrase from a secret. -->
        <gpg.keyname>763F8F8014A68EA3</gpg.keyname>
    </properties>
    <!-- GitHub Packages stays the target of a plain `mvn deploy`, for both
         snapshots and releases, exactly as before Maven Central came along.
         Maven Central is additional and reached only with the "release" profile:
         the central-publishing-maven-plugin registers as a build extension and
         takes over the deploy phase, so the two never run in the same command.

             mvn deploy              -> GitHub Packages (snapshot or release)
             mvn -Prelease deploy    -> Maven Central only

         Publishing a release to both means the same coordinates exist in two
         places. Fine as long as both carry identical bytes - run the two
         commands back to back, and if one fails, do not leave it at that. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Katrin4487/JAccessPDF</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Katrin4487/JAccessPDF</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Only the markdown module needs this; kept out of the root <dependencies>
                 (unlike slf4j/fop/Saxon) so it is not pulled into every module's classpath. -->
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>fop</artifactId>
            <version>${fop.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <!-- Run tests on the classpath, not the module path: JUnit needs
                         reflective access to test classes that production module-info.java
                         intentionally doesn't grant (it only opens packages to Jackson). -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <source>${java.release}</source>
                    <detectOfflineLinks>false</detectOfflineLinks>
                    <failOnError>false</failOnError>
                    <links>
                        <link>https://javadoc.io/doc/org.apache.xmlgraphics/fop-core/latest/</link>
                    </links>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.5</version>
                <configuration>
                    <header>${maven.multiModuleProjectDirectory}/license-header.txt</header>
                    <properties>
                        <owner>Katrin Kaiser</owner>
                        <year>2025</year>
                    </properties>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                    </mapping>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>**/.idea/**</exclude>
                    </excludes>
                    <strictCheck>true</strictCheck>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- NOTE: unrelated to the com.mycila plugin above despite the identical
                 artifactId - that one checks source file license HEADERS, this one
                 aggregates the LICENSES OF THIRD-PARTY DEPENDENCIES into THIRD-PARTY.txt.
                 Intentionally has no bound <executions>/<phase>: running it needs network
                 access to resolve license metadata, so it must stay a deliberate, manual
                 step (`mvn org.codehaus.mojo:license-maven-plugin:2.7.1:aggregate-add-third-party`),
                 not something that fires on every build. Always invoke it by its full
                 groupId:artifactId:version coordinates - both plugins share the short
                 "license" prefix, and declaring both here makes that prefix ambiguous. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <configuration>
                    <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <excludedScopes>test</excludedScopes>
                    <failOnMissing>false</failOnMissing>
                </configuration>
            </plugin>
        </plugins>

    </build>

    <profiles>
        <!-- Activated only for releases (`mvn -Prelease deploy`) so that everyday
             `mvn install` neither needs the GPG key nor contacts Central. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Override the lenient failOnError from the main <build>:
                         Central only checks that a javadoc JAR exists, not that it
                         has content, so a silent javadoc failure would ship an
                         empty JAR to javadoc.io - irreversibly. Release builds
                         must fail loudly instead. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <failOnError>true</failOnError>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${gpg.keyname}</keyname>
                            <!-- gpg 2.x refuses to read a passphrase from stdin
                                 unless pinentry is in loopback mode. Without this
                                 a CI build hangs silently on an invisible prompt. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- Must match the <server><id> in settings.xml that
                                 holds the Central Portal user token. -->
                            <publishingServerId>central</publishingServerId>
                            <!-- false = upload and validate, then wait for a manual
                                 "Publish" click in the portal. Flip to true once a
                                 few releases have gone through cleanly: a release
                                 pushed to Central can never be deleted or replaced. -->
                            <autoPublish>false</autoPublish>
                            <!-- Fail the build if Central's validation rejects the
                                 bundle, instead of reporting success on an upload
                                 that is sitting there broken. -->
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>